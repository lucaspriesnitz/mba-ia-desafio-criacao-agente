# Chave do Google AI Studio (https://aistudio.google.com/apikey)
GOOGLE_API_KEY=
# Usa a Gemini API do AI Studio, nao a Vertex AI (vazio ou FALSE)
GOOGLE_GENAI_USE_VERTEXAI=
# Modelo Gemini de cada agente (opcional; vazio usa o padrao descrito no README)
GEMINI_MODEL_PRINCIPAL=
GEMINI_MODEL_RESERVAS=
GEMINI_MODEL_VISITANTES=
GEMINI_MODEL_REGULAMENTO=
